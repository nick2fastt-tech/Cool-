# ============================================================================
# T10 configuration
# Copy to .env.local for development. Never commit real credentials.
# ============================================================================

# --- Public site ------------------------------------------------------------
# Your production origin. Drives canonical URLs, Open Graph tags, robots.txt
# and sitemap.xml. Leave unset locally; on Vercel it is detected automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain

# --- Chat model providers ---------------------------------------------------
# Each model names a provider adapter and an upstream model id.
# Adapters available: anthropic | openai | demo

# Anthropic Messages API
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Any OpenAI-compatible endpoint (OpenAI, Azure, Together, Groq, vLLM, Ollama,
# or your own T10 inference host)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Per-model binding. Set the upstream id your provider expects.
# T10_V1_PROVIDER=anthropic
# T10_V1_UPSTREAM_MODEL=
# T10_11_PROVIDER=anthropic
# T10_11_UPSTREAM_MODEL=

# Local demo adapter. NOT a T10 model - responses are generated on this server
# and every turn is labelled "Demo mode" in the UI. For interface exploration
# and automated tests only.
# T10_DEMO_MODE=false

# --- Image generation -------------------------------------------------------
# Providers available: openai | stability
# IMAGE_PROVIDER=openai
# IMAGE_MODEL=gpt-image-1
# STABILITY_API_KEY=

# --- Persistence (optional, for account-backed history) ---------------------
# Both must be set before server-side conversation storage is enabled.
# DATABASE_URL=
# AUTH_SECRET=

# --- Limits and timeouts ----------------------------------------------------
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_IMAGES=10
# RATE_LIMIT_DISABLED=false
# REQUEST_TIMEOUT_MS=120000
# IMAGE_TIMEOUT_MS=120000
