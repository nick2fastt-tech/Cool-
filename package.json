{
  "name": "novaverse",
  "version": "0.1.0",
  "private": true,
  "description": "NovaVerse \u2014 an original mobile sandbox game platform inspired by Roblox. 3D lobby, avatar customization, multiplayer, and multiple game modes. Built with Three.js + Capacitor for Android.",
  "type": "module",
  "scripts": {
    "start": "node ./tools/dev-server.js",
    "server": "node ./server/server.js",
    "build:android": "npx cap sync android",
    "open:android": "npx cap open android",
    "build:single": "node ./tools/build-single.mjs"
  },
  "keywords": [
    "game",
    "mobile",
    "android",
    "sandbox",
    "multiplayer",
    "threejs"
  ],
  "author": "NovaVerse Team",
  "license": "MIT",
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/cli": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "esbuild": "^0.28.1"
  }
}
