{
  "name": "hollow-shift",
  "version": "0.1.0",
  "private": true,
  "description": "Hollow Shift - a 3D mobile survival-horror night-watch game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node tests/smoke.mjs",
    "balance": "vitest run tools/balance.test.ts",
    "build:single": "node scripts/build-single-file.mjs",
    "smoke:single": "node scripts/build-single-file.mjs && SMOKE_FILE_URL=file://$PWD/hollow-shift.html SMOKE_PREFIX=single- node tests/smoke.mjs",
    "build:server": "node scripts/build-server.mjs",
    "server": "node scripts/build-server.mjs && node server-dist/server.mjs",
    "smoke:mp": "node tests/mp-browser.mjs",
    "coop-balance": "vitest run tools/coop-balance.test.ts"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "ws": "^8.21.3"
  }
}
