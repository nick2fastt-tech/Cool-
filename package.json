{
  "name": "hollow-shift",
  "version": "0.1.0",
  "private": true,
  "description": "Hollow Shift - a 3D mobile survival-horror night-watch game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node tests/smoke.mjs",
    "balance": "vitest run tools/balance.test.ts"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
